NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Leave empty to run without AI generation (the studio still works as a content + design tool).
ANTHROPIC_API_KEY=
AI_TEXT_MODEL=claude-opus-5-5
# Optional server-side PNG rendering via headless Chromium. Empty → in-browser renderer.
CHROMIUM_PATH=
# Playwright E2E account (use a dedicated test workspace)
E2E_EMAIL=
E2E_PASSWORD=
